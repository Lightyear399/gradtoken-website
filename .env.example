# Copy this file to .env and fill in real values before deploying.
# NEVER commit your actual .env file or private key to git. Never put real values in this file.
# Use a FRESH deployer wallet for Base. The old Sepolia deployer key was exposed and must never be reused.

# --- Sepolia (existing) ---
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# --- Phase 2 backend (Netlify Functions): also set in Netlify's dashboard ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SESSION_SECRET=32_plus_random_hex_chars_generate_with_crypto_randomBytes
GRAD_TOKEN_ADDRESS=0x95A69bcbF176497241887f9CcFd8EcBC4e596587
GRAD_STAKING_ADDRESS=0x6B24Ec9dA2f510DF0B2d8dFCd6788F00Cb84dFeD
GRAD_CERTIFICATE_ADDRESS=0xD338F85880716c3d03039798254211be596189C0
SITE_DOMAIN=gradtoken.netlify.app

# --- Base Sepolia deploy (new). Keep DEPLOYER_PRIVATE_KEY empty in this file; real value only in your untracked .env ---
