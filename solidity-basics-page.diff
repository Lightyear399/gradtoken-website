+/* ---------- GradLearn: project submission form ---------- */
+.project-submit-form{ display: flex; flex-direction: column; gap: 1.1rem; margin-top: 1.5rem; max-width: 560px; margin-left: auto; margin-right: auto; text-align: left; }
+.project-submit-form label{ font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-on-navy-muted); margin-bottom: -0.6rem; }
+.project-submit-form input,
+.project-submit-form textarea{ background: rgba(233, 228, 212, 0.04); border: 1px solid var(--border-on-navy); border-radius: 8px; padding: 0.75rem 0.9rem; color: var(--text-on-navy); font-family: inherit; font-size: 0.95rem; transition: border-color 0.15s ease, background 0.15s ease; }
+.project-submit-form input::placeholder,
+.project-submit-form textarea::placeholder{ color: var(--text-on-navy-muted); opacity: 0.7; }
+.project-submit-form input:focus,
+.project-submit-form textarea:focus{ outline: none; border-color: var(--brass-bright); background: rgba(233, 228, 212, 0.06); }
+.project-submit-form input[readonly]{ opacity: 0.7; cursor: default; }
+.project-submit-form textarea{ resize: vertical; min-height: 100px; }
+.project-submit-form button.btn-primary{ align-self: flex-start; margin-top: 0.4rem; cursor: pointer; border: none; font-family: inherit; }
